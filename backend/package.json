{
  "name": "weatherping-backend",
  "version": "0.1.0",
  "private": true,
  "description": "WeatherPing API: hyperlocal weather email alerts",
  "type": "commonjs",
  "main": "src/server.js",
  "engines": {
    "node": ">=26.12.0"
  },
  "scripts": {
    "dev": "node --watch-path=src src/server.js",
    "start": "node src/server.js",
    "lint": "eslint .",
    "seed:dev": "node scripts/seed-dev.js",
    "seed:e2e": "node scripts/seed-e2e.js",
